{% set items = [
  {
    'img': "/img/fleyt/example2.jpg",
    'title' : "Барнхаус",
    'size' : 65,
    'city' : "Челябинск",
    'sum' : "75 000",
    'pay' : "4000",
    'power' : 4
  },
  {
    'img': "/img/fleyt/example3.jpg",
    'title' : "ГАЗОБЛОК",
    'size' : 105,
    'city' : "Санкт-Петербург",
    'sum' : "575 000",
    'pay' : "7500",
    'power' : 11
  }
] %}
<div class="calculation">
  <div class="container container--5x7">
    <div class="calculation__left calculation__left--sticky container__left container__left--sticky">
      <div class="title title--h2">Примеры расчётов</div>
      <div class="filter filter--list">
        <a href="javascript:" class="filter__item filter__item--activate" data-filter-id="example-1">Частные дома</a>
        <a href="javascript:" class="filter__item" data-filter-id="example-2">Квартиры и лоджии</a>
        <a href="javascript:" class="filter__item" data-filter-id="example-3">Коммерческие объекты</a>
      </div>
    </div>
    <div class="container__content">
      <div class="filter__content filter__content--open" id="content-example-1">
        <div class="calculation__examples">
          <div class="example"
               style="background-image: linear-gradient(to right, rgba(0,0,0, 0) 50%, rgba(200,200,200, .5) 60%, rgba(200,200,200, 1)), url(/img/fleyt/example1.jpg);)">
            <a href="#" class="example__link link">Подробнее</a>
            <div class="example__title">Дубль Дом KEDR</div>
            <div class="example__wrapper">
              <div class="example__about">
                <div class="example__size">134<span>м&sup2;</span></div>
                <div class="example__city">Москва</div>
              </div>
              <div class="example__row">
                <div class="example__label">Стоимость оборудования</div>
                <div class="example__value">325 000<span>₽</span></div>
              </div>
              <div class="example__row">
                <div class="example__label">Мощность оборудования</div>
                <div class="example__value">7<span>кВт</span></div>
              </div>
              <div class="example__row">
                <div class="example__label">Среднемесячные расходы на&nbsp;отопление</div>
                <div class="example__value">10 000<span>₽</span></div>
              </div>
            </div>
          </div>

          {% for item in items %}
            {% include  "../elements/example.njk" %}
          {% endfor %}
        </div>

      </div>
      <div class="filter__content" id="content-example-2">
        <div class="calculation__examples">
          {% for item in items %}
            {% include  "../elements/example.njk" %}
          {% endfor %}
        </div>
      </div>
      <div class="filter__content" id="content-example-3">
        <div class="calculation__examples">
          Пусто
        </div>
      </div>

    </div>
  </div>
</div>
